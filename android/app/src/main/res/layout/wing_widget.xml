<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:background="@drawable/wing_widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Logo -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_widget_logo"
        android:contentDescription="Wingpact" />

    <!-- Steps -->
    <TextView
        android:id="@+id/tv_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="👟 0"
        android:textColor="#1a1814"
        android:textStyle="bold"
        android:textSize="15sp" />

    <!-- spacer (TextView, since a bare View is unsupported in RemoteViews) -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="" />

    <!-- Water: minus / value / plus -->
    <ImageButton
        android:id="@+id/btn_water_minus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/wing_widget_btn_bg"
        android:src="@drawable/ic_widget_minus"
        android:scaleType="centerInside"
        android:contentDescription="-" />

    <TextView
        android:id="@+id/tv_water"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="42dp"
        android:gravity="center"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="0L"
        android:textColor="#1a1814"
        android:textStyle="bold"
        android:textSize="15sp" />

    <ImageButton
        android:id="@+id/btn_water_plus"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/wing_widget_btn_bg"
        android:src="@drawable/ic_widget_plus"
        android:scaleType="centerInside"
        android:contentDescription="+" />

    <!-- SOS -->
    <TextView
        android:id="@+id/tv_sos"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp"
        android:gravity="center"
        android:background="@drawable/wing_widget_sos_bg"
        android:text="SOS"
        android:textColor="#d92d20"
        android:textStyle="bold"
        android:textSize="11sp" />

</LinearLayout>
