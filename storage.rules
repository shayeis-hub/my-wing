rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Meal images: only uploader can write, wing members can read
    match /meals/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Profile avatars
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Dietitian-uploaded client menus (PDF or photo). Only the owning coach can
    // upload or read; the extraction route reads them with the Admin SDK.
    match /menus/{coachId}/{clientId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == coachId;
      allow write: if request.auth != null && request.auth.uid == coachId
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }

    // Feed post images
    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
