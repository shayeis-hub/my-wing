rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // ── Course platform ────────────────────────────────────────────────────────

    // Courses / cohorts / enrollments: read requires login (was `if true` —
    // fully open, unauthenticated read AND write, on collections that
    // include personal enrollment data keyed by email — found via QA,
    // 2026-09). Nothing in this app's own client code writes to these
    // directly (only app/api/course/enroll, via the Admin SDK, which
    // bypasses these rules regardless) — write stays server-only. If a
    // separate app (the "Wing Course" platform, sharing this Firebase
    // project) writes to these client-side, it needs updating to go
    // through its own server route instead.
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /courseWeeks/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /days/{dayId} {
        allow read: if request.auth != null;
        allow write: if false;

        match /items/{itemId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }
    }

    match /cohorts/{cohortId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Enrollment lookup — keyed by email, so read is even more sensitive
    // than the above; same reasoning.
    match /enrollmentsByEmail/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Coach invite codes — coach reads own; all writes via Admin SDK (server)
    match /coachInvites/{code} {
      allow read: if request.auth != null && request.auth.uid == resource.data.coachId;
      allow write: if false;
    }

    // ── My Wing ────────────────────────────────────────────────────────────────

    // Users: owner or admin
    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // New account signup — anything except `role` (never client-settable;
      // absent/unset means "not admin" per isAdmin() above — found via QA,
      // 2026-09, that a client could otherwise self-grant admin at signup).
      allow create: if request.auth != null &&
        ((request.auth.uid == userId && !('role' in request.resource.data)) || isAdmin());

      // Updating your own doc is restricted to a whitelist of fields the
      // client legitimately writes directly (push token, avatar, profile
      // stats, timezone, notification prefs, switching to a wing you
      // already belong to, clearing the forced-password-change flag).
      // Privileged fields — role, subscription, courseAccess, coachAccess,
      // bookAccess, fitDadAccess, coach, coachCheckout, trophies,
      // trialStartsAt, wingIds, habitProgress — are changed exclusively via
      // server API routes using the Admin SDK, which bypasses these rules.
      // Without this, any signed-in user could grant themselves
      // premium/admin by writing those fields on their own doc directly
      // (found via QA, 2026-09).
      allow update: if request.auth != null &&
        (isAdmin() ||
         (request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['fcmToken', 'photoURL', 'displayName', 'profile', 'timezone',
             'notificationPrefs', 'wingId', 'mustChangePassword', 'viewOnlyAck']
          ) &&
          // .get(key, default) everywhere below — most accounts never have
          // wingId changed here / mustChangePassword set at all, and a bare
          // `.field` access on a key absent from the doc throws (denying
          // the whole update) rather than returning null in rules.
          (request.resource.data.get('wingId', null) == resource.data.get('wingId', null) ||
           request.resource.data.get('wingId', null) in resource.data.get('wingIds', [])) &&
          // mustChangePassword may only ever be cleared to false by the
          // client (never set to true) — see components/layout/AuthGuard.tsx.
          request.resource.data.get('mustChangePassword', false) == false));

      allow delete: if isAdmin();

      // Daily usage counters — only the owner can read/write
      match /dailyUsage/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Course enrollments — owner or admin
      match /enrollments/{enrollmentId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // Lesson completion progress — owner only
      match /progress/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Wings: members can read; owner can also list their wings by ownerId query
    match /wings/{wingId} {
      allow read: if request.auth != null &&
        (request.auth.uid in resource.data.memberIds ||
         request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null;
      // Members may update the wing doc from the client ONLY for
      // activeChallenge. Privileged fields (ownerId, adminIds, name,
      // inviteToken, and — as of 2026-09, found via QA — members/memberIds)
      // are changed exclusively via server API routes using the Admin SDK,
      // which bypasses these rules. This blocks a member from escalating
      // themselves to owner/admin, tampering with the wing name, OR adding/
      // removing arbitrary member uids directly (which also bypassed every
      // wing-size cap, since those are only enforced in the API routes, not
      // here). Member-list bookkeeping fixups (uid sync, avatar sync) now go
      // through app/api/wing/sync-member instead.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeChallenge']);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      // Meals: member can CRUD own meals, read group meals, any member can add comments
      match /meals/{mealId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Check-ins: same rules as meals
      match /checkins/{checkinId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Steps: members can read; only owner can write their own entry
      match /steps/{stepId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Weight logs: members can read all; only owner can write own entry
      match /weightLogs/{logId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Challenges: all members can read and write
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
      }

      // Daily Prompts: members can read and update (for responses/reactions); only members can create
      match /prompts/{promptId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create, update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if false;
      }

      // Wall messages: members can read; author can create own message; only author can delete
      match /wallMessages/{msgId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.authorId &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if false;
        // Author of the message OR owner of the wall (target) may delete
        allow delete: if request.auth != null &&
          (request.auth.uid == resource.data.authorId ||
           request.auth.uid == resource.data.targetUserId);
      }

      // Wing posts: members can read, create their own; any member can update (comments/reactions); only author can delete
      match /posts/{postId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }
    }
  }
}
