rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Daily usage counters — only the owner can read/write
      match /dailyUsage/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Wings: members can read; only owner can update metadata
    match /wings/{wingId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         request.auth.uid in resource.data.memberIds);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      // Meals: member can CRUD own meals, read group meals, any member can add comments
      match /meals/{mealId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Check-ins: same rules as meals
      match /checkins/{checkinId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Steps: members can read; only owner can write their own entry
      match /steps/{stepId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Weight logs: members can read all; only owner can write own entry
      match /weightLogs/{logId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Challenges: all members can read and write
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
      }
    }
  }
}
