rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // ── Course platform ────────────────────────────────────────────────────────

    // Courses: open read/write (admin protected at app level via secret key)
    match /courses/{courseId} {
      allow read, write: if true;
    }

    // Course content: open read/write (admin protected at app level via secret key)
    match /courseWeeks/{weekId} {
      allow read, write: if true;

      match /days/{dayId} {
        allow read, write: if true;

        match /items/{itemId} {
          allow read, write: if true;
        }
      }
    }

    // Cohorts: open read/write (admin protected at app level)
    match /cohorts/{cohortId} {
      allow read, write: if true;

      match /members/{memberId} {
        allow read, write: if true;
      }
    }

    // Enrollment lookup
    match /enrollmentsByEmail/{email} {
      allow read, write: if true;
    }

    // ── My Wing ────────────────────────────────────────────────────────────────

    // Users: owner or admin
    match /users/{userId} {
      allow read, write: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());

      // Daily usage counters — only the owner can read/write
      match /dailyUsage/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Course enrollments — owner or admin
      match /enrollments/{enrollmentId} {
        allow read, write: if request.auth != null &&
          (request.auth.uid == userId || isAdmin());
      }

      // Lesson completion progress — owner only
      match /progress/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Wings: members can read; only owner can update metadata
    match /wings/{wingId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
      // Members may update the wing doc from the client ONLY for non-privileged
      // fields (challenges + member-list sync/photo). Privileged fields
      // (ownerId, adminIds, name, inviteToken) are changed exclusively via
      // server API routes using the Admin SDK, which bypasses these rules.
      // This blocks a member from escalating themselves to owner/admin or
      // tampering with the wing name directly from the client.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['activeChallenge', 'members', 'memberIds']);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;

      // Meals: member can CRUD own meals, read group meals, any member can add comments
      match /meals/{mealId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Check-ins: same rules as meals
      match /checkins/{checkinId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Steps: members can read; only owner can write their own entry
      match /steps/{stepId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Weight logs: members can read all; only owner can write own entry
      match /weightLogs/{logId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }

      // Challenges: all members can read and write
      match /challenges/{challengeId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
      }

      // Daily Prompts: members can read and update (for responses/reactions); only members can create
      match /prompts/{promptId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create, update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if false;
      }

      // Wing posts: members can read, create their own; any member can update (comments/reactions); only author can delete
      match /posts/{postId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid == request.resource.data.userId &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/wings/$(wingId)).data.memberIds;
        allow delete: if request.auth != null &&
          request.auth.uid == resource.data.userId;
      }
    }
  }
}
